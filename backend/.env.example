# GuardNous backend — minimal settings for running the API on the host from
# this directory (cp .env.example .env). The full list with explanations is in
# ../.env.example. Only names defined in app/core/config.py may appear here:
# the backend rejects unknown names in this file.
#
# Ports 7000/7001 are the PostgreSQL and Redis containers started by
# `docker compose up -d postgres redis` in the repository root.
DATABASE_URL=postgresql+asyncpg://guardnous:guardnous@localhost:7000/guardnous
DATABASE_URL_SYNC=postgresql+psycopg2://guardnous:guardnous@localhost:7000/guardnous
REDIS_URL=redis://localhost:7001/0
CELERY_BROKER_URL=redis://localhost:7001/1
CELERY_RESULT_BACKEND=redis://localhost:7001/2
# openssl rand -hex 32
SECRET_KEY=change-me-use-openssl-rand-hex-32
# openssl rand -base64 32 | tr '+/' '-_'
ENCRYPTION_KEY=change-me-generate-with-cryptography-fernet-generate-key
DEBUG=false
# Used only when admin@guardnous.com is first created (needs the environment
# variable GUARDNOUS_SEED_ADMIN=true); empty = generated and logged once.
INITIAL_ADMIN_PASSWORD=

# URLs — change these for non-localhost deployments
FRONTEND_URL=http://localhost:7003
BACKEND_URL=http://localhost:7002
CORS_ORIGINS=["http://localhost:7003","http://localhost:7002"]
