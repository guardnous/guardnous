# ─────────────────────────────────────────────────────────────
# GuardNous — Environment Configuration
#
# Easiest: run ./scripts/setup.sh — it copies this file to .env and fills in
# SECRET_KEY, ENCRYPTION_KEY and INITIAL_ADMIN_PASSWORD for you.
# By hand: cp .env.example .env, then replace SECRET_KEY and ENCRYPTION_KEY
# (the API refuses to start with the placeholders).
#
# Under docker compose every line of .env is passed to the api and Celery
# containers, except the database/Redis addresses below: inside the containers
# those always point at the bundled postgres and redis services.
# ─────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────
APP_NAME=GuardNous
APP_VERSION=2.0.0
ENVIRONMENT=development
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-use-openssl-rand-hex-32
DEBUG=false

# ── First administrator ──────────────────────────────────────
# true  = create admin@guardnous.com the first time the API starts.
# false = no account is created; the first person to sign up at /register
#         becomes the administrator of their own organization.
GUARDNOUS_SEED_ADMIN=true
# Password for that account. Used only when the account is first created.
# Leave empty to have one generated and printed once in the api log
# (docker compose logs api). Change it after the first login.
INITIAL_ADMIN_PASSWORD=

# ── Database (PostgreSQL) ────────────────────────────────────
# These four addresses are for running the backend on the host
# (./scripts/dev.sh). Under docker compose they are replaced with the
# in-network service addresses; only POSTGRES_PASSWORD below matters there.
DATABASE_URL=postgresql+asyncpg://guardnous:guardnous@localhost:7000/guardnous
DATABASE_URL_SYNC=postgresql+psycopg2://guardnous:guardnous@localhost:7000/guardnous
# Password of the bundled PostgreSQL container. It is applied only when the
# database volume is first created; letters and digits only (it is put in a URL).
POSTGRES_PASSWORD=guardnous

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:7001/0
CELERY_BROKER_URL=redis://localhost:7001/1
CELERY_RESULT_BACKEND=redis://localhost:7001/2

# ── CORS & URLs ──────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:7003","http://localhost:7002"]
CORS_ALLOW_ALL=false
FRONTEND_URL=http://localhost:7003
BACKEND_URL=http://localhost:7002
# Public https:// address where /.well-known/openid-configuration is reachable from the
# internet. Needed to connect cloud accounts without access keys. Empty = use BACKEND_URL
# when it is https, otherwise the keyless option is off.
OIDC_ISSUER_URL=
# Optional: public S3 URL of the generic AWS onboarding template (GET /api/v1/cloud-accounts/aws/federation/template)
# to offer a one-click "Launch stack" link.
AWS_ONBOARDING_TEMPLATE_URL=

# ── JWT ──────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# ── Encryption (Fernet key for VCS token storage) ────────────
# 32 random bytes, URL-safe base64 (44 characters ending in "="). Generate with:
#   openssl rand -base64 32 | tr '+/' '-_'
# Keep it: data encrypted with one key cannot be read with another.
ENCRYPTION_KEY=change-me-generate-with-cryptography-fernet-generate-key

# ── GitHub OAuth (for VCS integration) ───────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:7003/integrations/callback

# ── GitHub App (enterprise — preferred over OAuth) ───────────
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_SLUG=guardnous
GITHUB_APP_CALLBACK_URL=http://localhost:7003/integrations/callback

# ── GitLab OAuth ─────────────────────────────────────────────
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_REDIRECT_URI=http://localhost:7003/integrations/callback

# ── Bitbucket OAuth ──────────────────────────────────────────
BITBUCKET_CLIENT_ID=
BITBUCKET_CLIENT_SECRET=
BITBUCKET_REDIRECT_URI=http://localhost:7003/integrations/callback

# ── Azure DevOps OAuth ───────────────────────────────────────
AZURE_DEVOPS_CLIENT_ID=
AZURE_DEVOPS_CLIENT_SECRET=
AZURE_DEVOPS_REDIRECT_URI=http://localhost:7003/integrations/callback

# ── NVD API (optional — increases CVE sync rate limit) ───────
NVD_API_KEY=
NVD_API_URL=https://services.nvd.nist.gov/rest/json/cves/2.0

# ── AI Copilot (optional) ───────────────────────────────────
# Runs in mock mode by default (no API key needed).
# Set LLM_PROVIDER to openai/azure/anthropic/ollama for real AI.
AGENT_ENABLED=true
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_API_VERSION=2024-06-01
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1200
AGENT_MAX_STEPS=6
# Background agent runs
AGENT_RUN_MAX_STEPS=12
AGENT_MONTHLY_TOKEN_BUDGET=0
AGENT_APPROVAL_TTL_HOURS=72
AGENT_ALLOW_SELF_APPROVAL=false
# Start a Triage Agent run by itself after an assessment that leaves open findings.
# It only proposes decisions; someone with agents:manage approves the list.
# Uses your LLM provider on every such assessment, so it is off by default.
AGENT_AUTO_TRIAGE_AFTER_SCAN=false
LLM_INPUT_PRICE_PER_MTOK=0
LLM_OUTPUT_PRICE_PER_MTOK=0

# ── Findings: time allowed to fix, in days, by severity (0 = no deadline) ──
SLA_DAYS_CRITICAL=7
SLA_DAYS_HIGH=30
SLA_DAYS_MEDIUM=90
SLA_DAYS_LOW=180
SLA_DAYS_INFO=0

# ── SBOM: look up dependency licences at deps.dev ────────────────
# Off by default because it sends the names and versions of your dependencies
# to a public service (https://deps.dev).
DEPENDENCY_LICENSE_LOOKUP=false

# ── Webhooks ────────────────────────────────────────────────
# VCS webhooks are verified with a per-organization secret that GuardNous
# generates (see GET /api/v1/integrations/webhook-config). This global value
# is not used for webhook verification.
WEBHOOK_SECRET=

# ── Rate limiting / proxies ─────────────────────────────────
# The built-in limiter is per process. Behind N reverse proxies, set
# TRUSTED_PROXY_COUNT=N so the client IP is read from X-Forwarded-For.
RATE_LIMIT_ENABLED=true
TRUSTED_PROXY_COUNT=0

# ── Demo data (never enable in production) ──────────────────
# true = allow sample cloud resources and simulated cloud-connector data
DEMO_DATA_ENABLED=false

# ── Scanner binary integrity ────────────────────────────────
# enforce = do not run a scanner whose SHA-256 changed; warn = log and run; off = no check
PLUGIN_INTEGRITY_MODE=enforce

# ── SMTP — Email Delivery (optional) ────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=noreply@guardnous.io
SMTP_FROM_NAME=GuardNous

# ── Super Admin ─────────────────────────────────────────────
SUPER_ADMIN_EMAIL=admin@guardnous.com

# ── Edition ──────────────────────────────────────────────────
# "community" (open-source) or "enterprise" (commercial)
EDITION=community

# ── Stripe Billing (optional — only when EDITION=enterprise) ─
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=price_pro_monthly
STRIPE_PRICE_ENTERPRISE=price_enterprise_monthly
